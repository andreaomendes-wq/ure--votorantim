// --- ARMAZENAMENTO E DADOS INICIAIS ---
let agendaData = JSON.parse(localStorage.getItem('ure_agenda')) || [
  { id: 1, escola: 'EE Pedro Augusto Rangel', data: '2026-10-05', objetivo: 'Acompanhamento do Plano de Ação de Língua Portuguesa e Matemática.' },
  { id: 2, escola: 'EE Profª Clotilde Beline', data: '2026-10-08', objetivo: 'Alinhamento formativo e verificação da frequência escolar.' }
];

let relatoriosData = JSON.parse(localStorage.getItem('ure_relatorios')) || [
  { id: 1, escola: 'EE Pedro Augusto Rangel', titulo: 'Relatório Formativo - Visita Presencial 1', data: '2026-09-15', link: 'https://www.w3.org/WAI/ER/tests/xhtml/testfiles/resources/pdf/dummy.pdf' },
  { id: 2, escola: 'EE Prof. Wilson Prestes', titulo: 'Acompanhamento de Metodologias Ativas', data: '2026-09-20', link: 'https://www.w3.org/WAI/ER/tests/xhtml/testfiles/resources/pdf/dummy.pdf' }
];

let fotosData = JSON.parse(localStorage.getItem('ure_fotos')) || [
  { id: 1, escola: 'EE Pedro Augusto Rangel', titulo: 'Oficina de Práticas Pedagógicas', url: 'https://images.unsplash.com/photo-1524178232363-1fb2b075b655?w=600&auto=format&fit=crop&q=80' },
  { id: 2, escola: 'EE Senador Lacerda Franco', titulo: 'Reunião do Conselho de Acompanhamento', url: 'https://images.unsplash.com/photo-1577896851231-70ef18881754?w=600&auto=format&fit=crop&q=80' }
];

let apoioData = JSON.parse(localStorage.getItem('ure_apoio')) || [
  { id: 1, prof: 'Profª Maria Silva', disciplina: 'Matemática', escola: 'EE Pedro Augusto Rangel', data: '2026-09-18', foco: 'Análise de itens críticos da avaliação diagnóstica.', link: 'https://www.w3.org/WAI/ER/tests/xhtml/testfiles/resources/pdf/dummy.pdf' },
  { id: 2, prof: 'Prof. Carlos Eduardo', disciplina: 'Língua Portuguesa', escola: 'EE Profª Clotilde Beline', data: '2026-09-22', foco: 'Estratégias de recomposição de aprendizagem em leitura.', link: 'https://www.w3.org/WAI/ER/tests/xhtml/testfiles/resources/pdf/dummy.pdf' }
];

let chartFreqInstance = null;
let chartDiscInstance = null;

// --- TROCA DE ABAS ---
function switchTab(tabName) {
  const tabs = ['agenda', 'relatorios', 'fotos', 'bi', 'apoio'];

  tabs.forEach(t => {
    const sec = document.getElementById(`sec-${t}`);
    const btn = document.getElementById(`tab-${t}`);

    if (sec) sec.classList.add('hidden');
    if (btn) {
      btn.classList.remove('bg-sky-800', 'text-white', 'shadow');
      btn.classList.add('text-sky-100', 'hover:bg-sky-800/60');
    }
  });

  const targetSec = document.getElementById(`sec-${tabName}`);
  const targetBtn = document.getElementById(`tab-${tabName}`);

  if (targetSec) targetSec.classList.remove('hidden');
  if (targetBtn) {
    targetBtn.classList.add('bg-sky-800', 'text-white', 'shadow');
    targetBtn.classList.remove('text-sky-100', 'hover:bg-sky-800/60');
  }

  // Se for a aba BI, desenha os gráficos após exibir a tela
  if (tabName === 'bi') {
    setTimeout(renderCharts, 100);
  }
}

// --- RENDERIZADORES ---
function renderAgenda() {
  const container = document.getElementById('agenda-list');
  const filterElem = document.getElementById('filter-escola-agenda');
  if (!container) return;

  const filter = filterElem ? filterElem.value : '';
  container.innerHTML = '';

  const list = filter ? agendaData.filter(a => a.escola === filter) : agendaData;

  if (list.length === 0) {
    container.innerHTML = `<p class="text-sm text-slate-500 bg-white p-4 rounded-xl border text-center">Nenhuma visita encontrada.</p>`;
    return;
  }

  list.forEach(item => {
    container.innerHTML += `
      <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm flex justify-between items-center">
        <div class="space-y-1">
          <span class="text-xs font-semibold px-2 py-0.5 rounded bg-sky-100 text-sky-800">${item.data}</span>
          <h4 class="font-bold text-slate-800 text-base">${item.escola}</h4>
          <p class="text-xs text-slate-600">${item.objetivo}</p>
        </div>
        <button onclick="removerItem('agenda', ${item.id})" class="text-red-500 hover:text-red-700 p-2 rounded-lg hover:bg-red-50 transition" title="Remover Visita">
          <i class="fa-solid fa-trash-can"></i>
        </button>
      </div>
    `;
  });
}

function renderRelatorios() {
  const container = document.getElementById('relatorios-list');
  if (!container) return;
  container.innerHTML = '';

  relatoriosData.forEach(item => {
    container.innerHTML += `
      <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm space-y-3">
        <div class="flex justify-between items-start">
          <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-slate-100 text-slate-600">${item.escola}</span>
          <button onclick="removerItem('relatorios', ${item.id})" class="text-red-500 hover:text-red-700 text-xs">
            <i class="fa-solid fa-trash-can"></i> Excluir
          </button>
        </div>
        <h4 class="font-bold text-slate-800 text-sm leading-snug">${item.titulo}</h4>
        <div class="flex justify-between items-center text-xs text-slate-500 pt-2 border-t">
          <span>Data: ${item.data}</span>
          <a href="${item.link}" target="_blank" class="text-sky-700 hover:underline font-semibold flex items-center gap-1">
            <i class="fa-solid fa-file-pdf"></i> Abrir Relatório
          </a>
        </div>
      </div>
    `;
  });
}

function renderFotos() {
  const container = document.getElementById('fotos-list');
  if (!container) return;
  container.innerHTML = '';

  fotosData.forEach(item => {
    container.innerHTML += `
      <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden group">
        <div class="h-40 overflow-hidden relative">
          <img src="${item.url}" alt="${item.titulo}" class="w-full h-full object-cover group-hover:scale-105 transition duration-300">
          <button onclick="removerItem('fotos', ${item.id})" class="absolute top-2 right-2 bg-red-600/80 hover:bg-red-600 text-white p-1.5 rounded-full text-xs transition">
            <i class="fa-solid fa-trash-can"></i>
          </button>
        </div>
        <div class="p-3">
          <span class="text-[10px] uppercase tracking-wider font-bold text-sky-700 block mb-1">${item.escola}</span>
          <p class="text-xs font-medium text-slate-700 line-clamp-2">${item.titulo}</p>
        </div>
      </div>
    `;
  });
}

function renderApoio() {
  const container = document.getElementById('apoio-list');
  if (!container) return;
  container.innerHTML = '';

  apoioData.forEach(item => {
    container.innerHTML += `
      <tr class="hover:bg-slate-50">
        <td class="p-4 font-semibold text-slate-800">${item.prof}</td>
        <td class="p-4">${item.disciplina} <br><span class="text-xs text-slate-400">${item.escola}</span></td>
        <td class="p-4">${item.data}</td>
        <td class="p-4 text-xs max-w-xs">${item.foco}</td>
        <td class="p-4">
          <a href="${item.link}" target="_blank" class="text-sky-700 hover:underline text-xs font-semibold flex items-center gap-1">
            <i class="fa-solid fa-paperclip"></i> Anexo PDF
          </a>
        </td>
        <td class="p-4 text-center">
          <button onclick="removerItem('apoio', ${item.id})" class="text-red-500 hover:text-red-700 text-xs">
            <i class="fa-solid fa-trash-can"></i> Excluir
          </button>
        </td>
      </tr>
    `;
  });
}

function removerItem(tipo, id) {
  if (confirm("Tem certeza que deseja excluir este registro?")) {
    if (tipo === 'agenda') {
      agendaData = agendaData.filter(i => i.id !== id);
      localStorage.setItem('ure_agenda', JSON.stringify(agendaData));
      renderAgenda();
    } else if (tipo === 'relatorios') {
      relatoriosData = relatoriosData.filter(i => i.id !== id);
      localStorage.setItem('ure_relatorios', JSON.stringify(relatoriosData));
      renderRelatorios();
    } else if (tipo === 'fotos') {
      fotosData = fotosData.filter(i => i.id !== id);
      localStorage.setItem('ure_fotos', JSON.stringify(fotosData));
      renderFotos();
    } else if (tipo === 'apoio') {
      apoioData = apoioData.filter(i => i.id !== id);
      localStorage.setItem('ure_apoio', JSON.stringify(apoioData));
      renderApoio();
    }
  }
}

// --- GRÁFICOS DO BI ---
function renderCharts() {
  const elemFreq = document.getElementById('chartFrequencia');
  const elemDisc = document.getElementById('chartDisciplinas');

  if (!elemFreq || !elemDisc) return;

  if (chartFreqInstance) chartFreqInstance.destroy();
  chartFreqInstance = new Chart(elemFreq.getContext('2d'), {
    type: 'bar',
    data: {
      labels: ['EE Pedro A. Rangel', 'EE Clotilde Beline', 'EE Wilson Prestes', 'EE Sen. Lacerda'],
      datasets: [{
        label: 'Frequência Alunos (%)',
        data: [91, 84, 89, 86],
        backgroundColor: '#0284c7',
        borderRadius: 6
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      scales: { y: { min: 60, max: 100 } }
    }
  });

  if (chartDiscInstance) chartDiscInstance.destroy();
  chartDiscInstance = new Chart(elemDisc.getContext('2d'), {
    type: 'doughnut',
    data: {
      labels: ['Matemática', 'Língua Portuguesa', 'Ciências/Física', 'Outras'],
      datasets: [{
        data: [45, 25, 20, 10],
        backgroundColor: ['#d97706', '#0284c7', '#059669', '#94a3b8']
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false
    }
  });
}

// --- MODAIS ---
function openModal(id) {
  const modal = document.getElementById(id);
  if (modal) modal.classList.remove('hidden');
}

function closeModal(id) {
  const modal = document.getElementById(id);
  if (modal) modal.classList.add('hidden');
}

function salvarAgenda(e) {
  e.preventDefault();
  agendaData.push({
    id: Date.now(),
    escola: document.getElementById('agenda-escola').value,
    data: document.getElementById('agenda-data').value,
    objetivo: document.getElementById('agenda-objetivo').value
  });
  localStorage.setItem('ure_agenda', JSON.stringify(agendaData));
  renderAgenda();
  closeModal('modal-agenda');
  e.target.reset();
}

function salvarRelatorio(e) {
  e.preventDefault();
  relatoriosData.push({
    id: Date.now(),
    titulo: document.getElementById('relatorio-titulo').value,
    escola: document.getElementById('relatorio-escola').value,
    link: document.getElementById('relatorio-link').value,
    data: new Date().toISOString().split('T')[0]
  });
  localStorage.setItem('ure_relatorios', JSON.stringify(relatoriosData));
  renderRelatorios();
  closeModal('modal-relatorio');
  e.target.reset();
}

function salvarFoto(e) {
  e.preventDefault();
  fotosData.push({
    id: Date.now(),
    titulo: document.getElementById('foto-titulo').value,
    escola: document.getElementById('foto-escola').value,
    url: document.getElementById('foto-url').value
  });
  localStorage.setItem('ure_fotos', JSON.stringify(fotosData));
  renderFotos();
  closeModal('modal-foto');
  e.target.reset();
}

function salvarApoio(e) {
  e.preventDefault();
  apoioData.push({
    id: Date.now(),
    prof: document.getElementById('apoio-prof').value,
    disciplina: document.getElementById('apoio-disc').value,
    escola: document.getElementById('apoio-escola').value,
    data: document.getElementById('apoio-data').value,
    foco: document.getElementById('apoio-foco').value,
    link: document.getElementById('apoio-link').value
  });
  localStorage.setItem('ure_apoio', JSON.stringify(apoioData));
  renderApoio();
  closeModal('modal-apoio');
  e.target.reset();
}

// --- INICIALIZAÇÃO ---
document.addEventListener('DOMContentLoaded', function() {
  renderAgenda();
  renderRelatorios();
  renderFotos();
  renderApoio();
});